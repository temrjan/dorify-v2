# ───────────────────────────────────────────────────────────────────
# Closes S-MED-11 — prevent .env / .git / node_modules / .claude utilities
# попадание в Docker build context. Без .dockerignore весь repo шёл бы
# в context при `context: .` (см. docker-compose.yml).
# ───────────────────────────────────────────────────────────────────

# Version control
.git/
.gitignore
.gitattributes

# Environment / secrets (NEVER в image layers)
.env
.env.*
!.env.example
!apps/*/.env.example

# Dependencies (re-installed внутри image)
node_modules/
**/node_modules/
.pnpm-store/

# Build outputs (re-built внутри image)
dist/
**/dist/
build/
.next/
.cache/
coverage/
*.tsbuildinfo

# Local toolchain
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Workflow / agent state (project rule)
.claude/

# Repo-specific reference docs не для runtime
docs/
*.md
!apps/*/README.md

# CI / git infra
.github/
.husky/

# Local-only gidstroy reference doc
docs/SPLIT-MODE.md
