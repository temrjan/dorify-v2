NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://dorify_user:dorify_dev_pass@localhost:5432/dorify_v2_db
REDIS_URL=redis://localhost:6379/5

JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h

BOT_TOKEN=your-telegram-bot-token

ALLOWED_ORIGINS=*

# Multicard (optional, per-pharmacy in DB)
MULTICARD_CALLBACK_URL=https://api.dorify.uz/api/v1/payments/callback

# Encryption key for Multicard secrets (AES-256)
ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-chars

# Telegram initData TTL (seconds). Default 300 (5 min) — audit S-HIGH-1
INIT_DATA_TTL_SECONDS=300

# Service token for bot → admin endpoints (verify/reject pharmacy).
# Generate via: openssl rand -hex 32
# MUST match apps/bot/.env ADMIN_SERVICE_TOKEN.
ADMIN_SERVICE_TOKEN=change-this-min-32-chars-shared-with-bot

# Admin login credentials (audit S-CRIT-1 — был hardcoded).
# Override ADMIN_USERNAME в production для defense-in-depth.
# Generate ADMIN_PASSWORD_HASH:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
