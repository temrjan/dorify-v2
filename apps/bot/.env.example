BOT_TOKEN=your-telegram-bot-token
WEBAPP_URL=https://app.dorify.uz
API_URL=https://api.dorify.uz/api/v1
HEALTH_PORT=3002

# Admin Telegram chat IDs — comma-separated numeric IDs.
# Receive pharmacy approval DMs from backend.
ADMIN_CHAT_IDS=

# Service token для admin endpoint calls (mirror of api's ADMIN_SERVICE_TOKEN).
# Bot sends в X-Service-Token header при approve/reject pharmacy.
ADMIN_SERVICE_TOKEN=change-this-min-32-chars-shared-with-api
